        <mxCell id="async-concept" value="💡 Core Idea: Decouple prediction from execution&#xa;Robot acts while policy computes next chunk" style="text;strokeColor=#F06292;fillColor=#F8BBD0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;fontColor=#C2185B;fontStyle=1;" vertex="1" parent="async-section">
          <mxGeometry y="30" width="420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="async-client" value="🤖 RobotClient:&#xa;• Executes actions from queue&#xa;• Sends observations when queue < threshold g" style="text;strokeColor=#F06292;fillColor=#F8BBD0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;fontColor=#C2185B;" vertex="1" parent="async-section">
          <mxGeometry y="70" width="420" height="50" as="geometry" />
        </mxCell>
        <mxCell id="async-server" value="🖥️ PolicyServer (can be remote GPU):&#xa;• Receives observations&#xa;• Computes action chunks A_t&#xa;• Sends back to client" style="text;strokeColor=#F06292;fillColor=#F8BBD0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;fontColor=#C2185B;" vertex="1" parent="async-section">
