        </mxCell>
        <mxCell id="async-threshold" value="⚖️ Queue Threshold g ∈ [0,1]:&#xa;g=0: fully sync (idle gaps)&#xa;g=0.7: optimal balance (recommended)&#xa;g=1: always predict (compute-intensive)" style="text;strokeColor=#F06292;fillColor=#F8BBD0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=4;overflow=hidden;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;rotatable=0;whiteSpace=wrap;html=1;fontSize=11;fontColor=#C2185B;" vertex="1" parent="async-section">
